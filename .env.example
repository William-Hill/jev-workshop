# Copy this file to .env and add the key from console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional: use a local server with the same protocol in place of Jev.
# Ollama 0.35 or later: run `ollama pull nimble`, then remove the # from these lines.
# JEV_UPSTREAM_URL=http://localhost:11434/v1/systemone
# JEV_MODEL=nimble

# Optional: System 2 and the LLM-only path. The key stays on the server.
# LLM_BACKEND is claude-cli (headless Claude Code, the default with no key), anthropic, or none.
# LLM_BACKEND=claude-cli
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
